# ---------------------------------------------------------------------------
# Server-side only (no VITE_ prefix): read by the local proxy in vite.config.ts
# and never bundled into the browser. Copy this file to .env and fill the token.
# ---------------------------------------------------------------------------

# api.sncf.com (Navitia, coverage "sncf")
SNCF_API_BASE=https://api.sncf.com/v1
SNCF_API_COVERAGE=sncf

# Your SNCF/Navitia API token.
SNCF_API_TOKEN=

# "basic" for api.sncf.com, "bearer" for api.navitia.io
SNCF_API_AUTH_MODE=basic

# Placeholder while the SNCF portal is unavailable: returns synthetic direct
# journeys (stable duration per station pair) so the live code path and the UI
# can be tested without a token. Set to false once SNCF_API_TOKEN is filled in.
SNCF_API_MOCK=false

# ---------------------------------------------------------------------------
# Client-side flags (public, bundled). Optional.
# ---------------------------------------------------------------------------

# Set to false to skip the live SNCF call and use the static GTFS table only.
# VITE_TRAIN_API=true
# Set to false to skip OSRM and use straight-line walk/bike estimates.
# VITE_ROUTING=true

# Demo the "Avis" (ratings) filter with deterministic simulated values.
# Prefer real data: add data/ratings.csv and run `npm run data:build`.
# VITE_RATINGS_MOCK=true
